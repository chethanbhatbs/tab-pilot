{
  "manifest_version": 3,
  "name": "Tab Radar",
  "version": "1.3.0",
  "description": "A keyboard-first command center for finding, switching, cleaning, and focusing Chrome tabs.",
  "permissions": [
    "tabs",
    "tabGroups",
    "sidePanel",
    "storage",
    "sessions",
    "history",
    "favicon",
    "idle",
    "alarms"
  ],
  "optional_permissions": ["nativeMessaging"],
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Tab Radar",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Toggle Tab Radar sidebar"
    },
    "open-command-center": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open Tab Radar command center"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
